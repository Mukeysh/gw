<?php

/**
 * @file
 * Canvas prop-shape overrides for Growibes HTML/CSS paste fields.
 */

declare(strict_types=1);

use Drupal\canvas\PropExpressions\StructuredData\FieldTypePropExpression;
use Drupal\canvas\PropShape\CandidateStorablePropShape;

/**
 * Implements hook_canvas_storable_prop_shape_alter().
 */
function growibes_canvas_canvas_storable_prop_shape_alter(CandidateStorablePropShape $storable_prop_shape): void {
  if (($storable_prop_shape->shape->schema['x-textarea'] ?? FALSE) !== TRUE) {
    return;
  }
  $storable_prop_shape->fieldTypeProp = new FieldTypePropExpression('string_long', 'value');
  $storable_prop_shape->fieldWidget = 'string_textarea';
}
