<?php

/**
 * @file
 * Growibes theme preprocess implementations.
 */

declare(strict_types=1);

use Drupal\Core\Menu\MenuTreeParameters;
use Drupal\Core\Render\Element;
use Drupal\Core\Url;
use Symfony\Component\HttpKernel\Exception\AccessDeniedHttpException;
use Symfony\Component\HttpKernel\Exception\NotFoundHttpException;

/**
 * Implements hook_preprocess_html().
 */
function growibes_preprocess_html(array &$variables): void {
  $variables['html_attributes']->setAttribute('lang', $variables['html_attributes']['lang'] ?? 'en');
}

/**
 * Implements hook_preprocess_page().
 *
 * Header and footer always come from homepage-final unless Canvas (or a block)
 * already filled those regions.
 */
/**
 * Implements hook_theme_suggestions_page_alter().
 */
function growibes_theme_suggestions_page_alter(array &$suggestions, array $variables): void {
  if (growibes_is_contact_page()) {
    $suggestions[] = 'page__contact';
  }
  if (growibes_system_page_kind() !== '') {
    $suggestions[] = 'page__system';
  }
}

function growibes_preprocess_page(array &$variables): void {
  $variables['growibes_canvas'] = !empty($variables['rendered_by_canvas']);
  if (growibes_is_contact_page()) {
    $variables['#attached']['library'][] = 'growibes/contact';
  }

  $kind = growibes_system_page_kind();
  if ($kind !== '') {
    $variables['#attached']['library'][] = 'growibes/system';
    $variables['gw_system'] = growibes_system_page_copy($kind);
  }

  if (!growibes_region_has_content($variables['page']['header'] ?? [])) {
    $logo_path = \Drupal::service('extension.list.theme')->getPath('growibes') . '/logo.png';
    $variables['page']['header']['growibes_header'] = [
      '#type' => 'component',
      '#component' => 'growibes:header',
      '#props' => [
        'logo_src' => \Drupal::service('file_url_generator')->generateString($logo_path),
      ],
      '#slots' => [
        'navigation' => growibes_build_main_menu(),
      ],
      '#weight' => -100,
    ];
  }

  if (!growibes_region_has_content($variables['page']['footer'] ?? [])) {
    $logo_path = \Drupal::service('extension.list.theme')->getPath('growibes') . '/logo.png';
    $variables['page']['footer']['growibes_footer'] = [
      '#type' => 'component',
      '#component' => 'growibes:footer',
      '#props' => [
        'logo_src' => \Drupal::service('file_url_generator')->generateString($logo_path),
      ],
      '#slots' => [
        'navigation' => growibes_build_footer_menu(),
      ],
      '#weight' => 100,
    ];
  }
}

/**
 * Builds the Drupal Main menu as a fully expanded tree.
 */
function growibes_build_main_menu(): array {
  $menu_tree = \Drupal::menuTree();
  $parameters = new MenuTreeParameters();
  $parameters->onlyEnabledLinks();
  $parameters->setMaxDepth(3);
  $ids = [];
  foreach (\Drupal::entityTypeManager()->getStorage('menu_link_content')->loadByProperties(['menu_name' => 'main']) as $link) {
    $ids[] = 'menu_link_content:' . $link->uuid();
  }
  if ($ids) {
    $parameters->expandedParents = array_values(array_unique(array_merge([''], $ids)));
  }
  $tree = $menu_tree->load('main', $parameters);
  $tree = $menu_tree->transform($tree, [
    ['callable' => 'menu.default_tree_manipulators:checkAccess'],
    ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
  ]);
  return $menu_tree->build($tree);
}

/**
 * Same Main menu tree as the header, rendered as footer columns.
 */
function growibes_build_footer_menu(): array {
  $build = growibes_build_main_menu();
  $build['#theme'] = 'menu__footer';
  return $build;
}

/**
 * Implements hook_preprocess_menu().
 */
function growibes_preprocess_menu(array &$variables): void {
  if (($variables['menu_name'] ?? '') !== 'main') {
    return;
  }
  growibes_prepare_menu_items($variables['items']);
}

/**
 * Marks mega columns and nolink parents on a menu item tree.
 */
function growibes_prepare_menu_items(array &$items): void {
  foreach ($items as &$item) {
    $url = $item['url'] ?? NULL;
    $item['is_nolink'] = $url instanceof \Drupal\Core\Url
      && $url->isRouted()
      && $url->getRouteName() === '<nolink>';
    $item['is_mega'] = FALSE;
    foreach ($item['below'] as $child) {
      if (!empty($child['below'])) {
        $item['is_mega'] = TRUE;
        break;
      }
    }
    if (!empty($item['below'])) {
      growibes_prepare_menu_items($item['below']);
    }
  }
}

/**
 * Returns TRUE when a page region contains a visible child.
 */
/**
 * Implements hook_form_FORM_ID_alter().
 */
function growibes_form_webform_submission_growibes_contact_add_form_alter(array &$form, $form_state, $form_id): void {
  $form['#attributes']['class'][] = 'gw-contact-form';
  $form['actions']['submit']['#attributes']['class'][] = 'submit';
}

/**
 * Kind of Drupal system page to restyle: 404, 403, user, or empty.
 */
function growibes_system_page_kind(): string {
  $request = \Drupal::requestStack()->getCurrentRequest();
  $exception = $request?->attributes->get('exception');
  if ($exception instanceof NotFoundHttpException) {
    return '404';
  }
  if ($exception instanceof AccessDeniedHttpException) {
    return '403';
  }
  $route = (string) \Drupal::routeMatch()->getRouteName();
  if ($route === 'system.404') {
    return '404';
  }
  if ($route === 'system.403') {
    return '403';
  }
  if ($route === 'entity.user.canonical' || $route === 'entity.user.edit_form' || str_starts_with($route, 'user.')) {
    return 'user';
  }
  return '';
}

/**
 * Copy and flags for user / 403 / 404 templates.
 */
function growibes_system_page_copy(string $kind): array {
  if ($kind === '404') {
    return [
      'kind' => '404',
      'kicker' => 'Growibes / 404',
      'title' => 'This page is not here.',
      'dek' => 'The URL may have moved, or it never existed. The rest of the site is still where you left it.',
      'actions' => TRUE,
      'login' => FALSE,
      'show_content' => FALSE,
    ];
  }
  if ($kind === '403') {
    return [
      'kind' => '403',
      'kicker' => 'Growibes / 403',
      'title' => 'This door is closed.',
      'dek' => 'You do not have access to this page. If you should, sign in — or talk to us if something looks wrong.',
      'actions' => TRUE,
      'login' => TRUE,
      'show_content' => FALSE,
    ];
  }
  $route = (string) \Drupal::routeMatch()->getRouteName();
  $title = 'Sign in.';
  $dek = 'For the Growibes team and invited partners.';
  if ($route === 'user.pass') {
    $title = 'Reset your password.';
    $dek = 'We will email a one-time login link.';
  }
  elseif ($route === 'user.register') {
    $title = 'Create an account.';
    $dek = 'Registration is limited.';
  }
  elseif ($route === 'entity.user.canonical' || $route === 'entity.user.edit_form') {
    $title = 'Your account.';
    $dek = '';
  }
  return [
    'kind' => 'user',
    'kicker' => 'Growibes / Account',
    'title' => $title,
    'dek' => $dek,
    'actions' => FALSE,
    'login' => FALSE,
    'show_content' => TRUE,
  ];
}

/**
 * Returns TRUE on the Growibes contact Webform page.
 */
function growibes_is_contact_page(): bool {
  $route = \Drupal::routeMatch();
  if ($route->getRouteName() === 'entity.webform.canonical') {
    $webform = $route->getParameter('webform');
    return $webform && $webform->id() === 'growibes_contact';
  }
  $path = \Drupal::service('path.current')->getPath();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($path);
  return $alias === '/contact' || $path === '/contact';
}

function growibes_region_has_content(array $region): bool {
  foreach (Element::getVisibleChildren($region) as $key) {
    if (is_array($region[$key]) && $region[$key] !== []) {
      return TRUE;
    }
  }
  return FALSE;
}
