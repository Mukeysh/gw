{#
/**
 * @file
 * Minimal block template so SDC markup is not wrapped in Drupal block chrome
 * unless the block actually has a visible title.
 */
#}
<div{{ attributes }}>
  {{ title_prefix }}
  {% if label %}
    <h2{{ title_attributes }}>{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}
  {% block content %}
    {{ content }}
  {% endblock %}
</div>
