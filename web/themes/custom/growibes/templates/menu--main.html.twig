{#
/**
 * @file
 * Growibes main navigation — mega dropdown + simple dropdowns.
 */
#}
{% import _self as menus %}
{{ menus.links(items, attributes, 0, '') }}

{% macro links(items, attributes, menu_level, list_class) %}
  {% import _self as menus %}
  {% if items %}
    {% if menu_level == 0 %}
      <ul{{ attributes.addClass('gw-nav') }}>
    {% else %}
      <ul class="{{ list_class }}">
    {% endif %}
    {% for item in items %}
      {% set has_children = item.below is not empty %}
      {% if menu_level == 0 %}
        <li class="gw-nav__item{{ has_children ? ' gw-nav__item--parent' : '' }}{{ item.is_mega ? ' gw-nav__item--mega' : '' }}">
          {% if has_children and item.is_nolink %}
            <button type="button" class="gw-nav__link gw-nav__parent-link gw-nav__trigger" aria-expanded="false">{{ item.title }}</button>
          {% elseif has_children %}
            <a href="{{ item.url }}" class="gw-nav__link gw-nav__parent-link" aria-expanded="false">{{ item.title }}</a>
          {% else %}
            <a href="{{ item.url }}" class="gw-nav__link">{{ item.title }}</a>
          {% endif %}
          {% if has_children %}
            <div class="gw-nav__panel{{ item.is_mega ? ' gw-nav__panel--mega' : '' }}">
              <div class="gw-nav__panel-inner">
                {{ menus.links(item.below, create_attribute(), 1, item.is_mega ? 'gw-nav__mega' : 'gw-nav__list') }}
              </div>
            </div>
          {% endif %}
        </li>
      {% elseif menu_level == 1 and list_class == 'gw-nav__mega' %}
        <li class="gw-nav__col">
          {% if item.is_nolink %}
            <span class="gw-nav__col-title">{{ item.title }}</span>
          {% else %}
            <a class="gw-nav__col-title" href="{{ item.url }}">{{ item.title }}</a>
          {% endif %}
          {% if has_children %}
            {{ menus.links(item.below, create_attribute(), 2, '') }}
          {% endif %}
        </li>
      {% else %}
        <li>
          <a href="{{ item.url }}">{{ item.title }}</a>
        </li>
      {% endif %}
    {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
