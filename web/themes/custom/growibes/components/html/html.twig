{#
/**
 * @file
 * Isolated HTML+CSS island for unique Growibes page art direction.
 *
 * Paste production page body HTML and its CSS. Global header/footer stay
 * outside this island. JS moves children into shadow DOM so page CSS cannot
 * restyle site chrome. Without JS, markup still renders in the light DOM.
 */
#}
<div{{ attributes.addClass('gw-html') }}>
  {# Must sit inside the island so it applies in Shadow DOM. #}
  <link rel="stylesheet" href="/themes/custom/growibes/components/html/island.css">
  {% if css %}
    <style>{{ css|raw }}</style>
  {% endif %}
  <div class="gw-html__content">
  {{ html|raw }}
  </div>
</div>
